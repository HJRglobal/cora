MAKE_SALES_DECK_WEBHOOK_URL=https://hook.us1.make.com/your-webhook-id-here  # optional; default ""

# -----------------------------------------------------------------------------
# Curated financial Google Sheet (Standing ACTUALS cashflow reader)
# -----------------------------------------------------------------------------
GSHEETS_CASHFLOW_FILE_ID=your-cashflow-sheet-file-id  # optional; default "" (cashflow tool degrades)
# Tab name to read from the cashflow sheet. Override only if the tab is renamed.
# GSHEETS_CASHFLOW_SHEET_NAME=CF_SUMMARY            # default CF_SUMMARY

# -----------------------------------------------------------------------------
# F3E warehouse inventory Google Sheet (Cotton 3PL SKU pulse)
# -----------------------------------------------------------------------------
# F3E_INVENTORY_FILE_ID=your-f3e-inventory-sheet-file-id  # optional; default "" (inventory tool degrades)

# -----------------------------------------------------------------------------
# Fighter / influencer compliance tracker Google Sheet (MMA Lab x F3)
# -----------------------------------------------------------------------------
FIGHTER_TRACKER_SHEET_ID=your-fighter-tracker-sheet-id  # optional; default "" (tracker tool degrades)

# -----------------------------------------------------------------------------
# Instagram / Meta -- influencer scanner (see deployment/META_SETUP_GUIDE.md)
# -----------------------------------------------------------------------------
# Short-lived tokens expire ~1h; always exchange for Long-Lived (60-day) tokens.
# NOTE (2026-07-03 audit): META_APP_ID/SECRET + the INSTAGRAM_* vars are read by
# the Meta app setup / token-generation path and the influencer scanner scripts,
# not by the always-on bot's src/ modules. Keep them set if the scanner runs.
INSTAGRAM_F3E_USER_ID=<numeric IG Business Account ID>
INSTAGRAM_F3E_ACCESS_TOKEN=<long-lived user access token>
INSTAGRAM_F3MOOD_USER_ID=<numeric IG Business Account ID>
INSTAGRAM_F3MOOD_ACCESS_TOKEN=<long-lived user access token>
INSTAGRAM_F3PURE_USER_ID=<numeric IG Business Account ID>
INSTAGRAM_F3PURE_ACCESS_TOKEN=<long-lived user access token>
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Slack channel (no #) for influencer detection alerts. Read by run_influencer_scan.py.
INFLUENCER_SCAN_NOTIFY_CHANNEL=f3-sales             # default f3-sales

# -----------------------------------------------------------------------------
# Email attachment auto-filer -- scripts/run_attachment_filer.py
# -----------------------------------------------------------------------------
# Reuses GOOGLE_SERVICE_ACCOUNT_JSON + ANTHROPIC_API_KEY + SLACK_BOT_TOKEN.
# DWD scope needed per monitored account: .../auth/gmail.modify
EMAIL_FILING_NOTIFY_CHANNEL=cora-filing             # default cora-filing (bot must be a member)
EMAIL_FILING_LOOKBACK_HOURS=24                      # default 24 (first-run backfill window)
# Per-run self-budget (seconds) before the filer stops and resumes next run.
# EMAIL_FILING_RUN_BUDGET_SECONDS=780               # default 780 (13 min < 20-min task limit)
# Crash-safe dedup ledgers (D-053). Leave unset; default to data/state/*.jsonl.
# FILER_CONTENT_LEDGER_PATH=                        # optional; default = data/state/filer-content-ledger.jsonl
# FILER_MESSAGE_LEDGER_PATH=                        # optional; default = data/state/filer-message-ledger.jsonl
# FILER_CONTENT_TTL_DAYS=365                         # default 365
# FILER_MESSAGE_TTL_DAYS=60                           # default 60

# -----------------------------------------------------------------------------
# Finance receipt digest -- scripts/run_finance_receipt_digest.py (W4-02)
# -----------------------------------------------------------------------------
# The weekly digest posts to the pinned #hjr-finance channel (channel_id in
# data/maps/finance-receipt-allowlist.yaml). If that post fails (e.g. the
# channel is archived), a metadata-only DELIVERY-FAILURE alert (no vendor/amount
# lines -- the finance firewall) goes to a live ops channel instead. Resolution
# order: FINANCE_DIGEST_FALLBACK_CHANNEL -> HEALTH_REPORT_CHANNEL -> hjrg-leadership.
# FINANCE_DIGEST_FALLBACK_CHANNEL=                   # optional; else HEALTH_REPORT_CHANNEL, else hjrg-leadership
# HEALTH_REPORT_CHANNEL=hjrg-leadership              # also read by scripts/nightly_health_check.py; default hjrg-leadership

# -----------------------------------------------------------------------------
# OSN shift scheduler
# -----------------------------------------------------------------------------
# Comma-separated Slack user IDs allowed to run generate/approve/publish.
OSN_SCHEDULER_ADMIN_USER_IDS=U0B2RM2JYJ1,U0B3PS7RFJA,U0B4L78SZHN  # OPERATIONAL value (Harrison,Matt,Micah); code default is "" (no admin if unset)
# Slack channel (no #) where schedule drafts post for ✅ approval.
OSN_SCHEDULER_APPROVAL_CHANNEL=osn-scheduling       # default osn-scheduling

# -----------------------------------------------------------------------------
# Uptime monitoring (Stage 2 -- 2026-06-11)
# -----------------------------------------------------------------------------
# Local /health endpoint. 200+JSON while heartbeat is fresh (<180s), else 503.
# HEALTH_PORT=0 disables. Binds 127.0.0.1 by default; widen HEALTH_BIND only for
# a tunnel/LAN probe.
HEALTH_PORT=8787                                    # default 8787
HEALTH_BIND=127.0.0.1                               # default 127.0.0.1
# Outbound dead-man ping (healthchecks.io / UptimeRobot heartbeat). Blank disables.
HEALTH_PING_URL=                                    # default "" (disabled)
HEALTH_PING_INTERVAL_S=300                          # default 300

# -----------------------------------------------------------------------------
# Security monitor -- scripts/security_monitor.py
# -----------------------------------------------------------------------------
SECURITY_ALERT_CHANNEL=cora-build                   # default cora-build

# -----------------------------------------------------------------------------
# Logging + identity
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO                                    # default INFO
# Harrison's Slack user id -- used by knowledge_review as the sole approver (D-011).
# HARRISON_SLACK_USER_ID=U0B2RM2JYJ1                # default U0B2RM2JYJ1

# -----------------------------------------------------------------------------
# Knowledge base + known-answers + path overrides
# -----------------------------------------------------------------------------
# The live bot points KNOWN_ANSWERS_DIR at the Drive _brain store; unset falls
# back to the in-repo design/known-answers/. All *_DIR/*_PATH below default to
# sensible repo/Drive paths -- leave unset unless relocating data.
# CORA_KB_DB_PATH=                                  # optional; default = data/cora_kb.db
# KNOWN_ANSWERS_DIR=                                # optional; default = design/known-answers  (live: _brain/known-answers)
# DYNAMIC_ANSWERS_DIR=                              # optional; default = design/known-answers/dynamic
# BRAIN_PEOPLE_DIR=                                 # optional; default = _brain/people (person dossiers)
# SWEPT_DIR=                                        # optional; default = _brain/swept (materializer export)
# FLYWHEEL_MIRROR_DIR=                              # optional; default = _brain/_flywheel (ledger mirror)
# MATERIALIZER_KB_DB_PATH=                          # optional; default = data/cora_kb.db (materializer read)
# MATERIALIZATION_WATERMARK_PATH=                   # optional; default = data/state/materialization-watermark.json

# -----------------------------------------------------------------------------
# Feature flags -- proactive-emitter gates (Phase 0 rebuild, 2026-06-16)
# -----------------------------------------------------------------------------
# These emitters are MUTED by default (empty ⇒ off). Set true only once a
# surface's precision/data is trusted. Reads live in the scheduled-task scripts.
# CASH_PULSE_ENABLED=true                           # default off  (daily Cash Pulse push; run_cashflow_pulse.py)
# CORA_HUBSPOT_EMAIL_SYNC_DM_ENABLED=true           # default off  (HubSpot email-match DM prompts)
# COMPLETION_SWEEP_POST_ENABLED=true                # default off  (completion-candidate digest)
# DECISION_CAPTURE_POST_ENABLED=true                # default off  (decision-capture digest)
# CORA_EVAL_MODE=1                                  # default off  (KB eval harness; test/eval runs only)
# FINANCE_CLOSE_NARRATE=true                        # default off  (weekly close-support pack: add a Haiku
#                                                   #  one-paragraph RESTATEMENT above the facts block.
#                                                   #  The facts block is always deterministic; narration is
#                                                   #  fed only the already-computed lines and fails closed.)

# -----------------------------------------------------------------------------
# RESERVED operational flags -- set to the RATIFIED value, NOT the code default
# -----------------------------------------------------------------------------
# ⚠️ drive-extractor proposals are PAUSED (D-066, ratified 2026-07-02). The CODE
#    DEFAULT is "1" (ENABLED) -- so this MUST be present as =0 or a rebuild from
#    this template would silently RE-ENABLE the pause. Do not flip without a
#    ratified decision (RESERVED). This is the W9-01 silent-reversal fix.
DRIVE_EXTRACTOR_PROPOSALS_ENABLED=0                 # code default "1"; RATIFIED = 0 (PAUSED, D-066)
# DRIVE_EXTRACTOR_MAX_PROPOSALS_PER_RUN=50          # default 50 (cap when un-paused)
# Graduated-trust SHADOW instrumentation. Default ON = measurement only; it
# flips NOTHING (D-063). The actual graduated-trust FLIP is a separate reserved
# decision -- do not conflate turning shadow off with flipping trust on.
# CORA_GRADUATED_SHADOW=0                            # default ON (measurement-only)
# CORA_GRADUATED_SHADOW_DIR=                         # optional; default = logs/
# Graduated-trust AUTO-WRITE FLIP (2026-07-21, D-011 relaxed -> reversible). The
# shadow above measures; THIS flips it live. Default OFF = today's behavior (every
# knowledge item DMs Harrison). 'tier0' = only CORROBORATED+allowlist+recognized
# items auto-write; 'all' = Tier-0 AND Tier-1. Tier-2 (money/contracts/legal/
# equity/comp/PHI/LEX/cross-entity/conflicts-with-canon) is NEVER auto-written.
# Every auto-write is audited (logs/cora-autowrite-audit.jsonl) + one-tap
# revertible in the weekly cowork-cora-autowrite-digest. NOTE: the flip is
# SCRIPT-SIDE -- the Mon-Fri 7am knowledge-review re-reads .env each fire, so a
# value change activates at the NEXT fire (no bot restart). Only the digest's
# revert BUTTON needs the bot on current main. Value MUST be off|tier0|all -- any
# other value (e.g. '1') silently falls back to 'off'.
# CORA_AUTOWRITE_LIVE=off                            # off (default) | tier0 | all
# CORA_CODE_QUEUE=off                                # off (default, inert) | log (capture+ledger+backlog, no DMs) | live (+ immediate DM cards). Code-session queue rollout flag; read per-call (no restart to flip). Any other value -> off.
# CORA_DELEGATED_WORK=off                            # off (default) | log (intake+ledger; runner claims+SIMULATED, no model calls/delivery) | live. Delegated-work rollout flag. Bot reads .env ONCE at start -- flipping the BOT needs a restart; the runner (scripts\run_delegated_work_runner.py) reads it fresh each fire, so log->live is restart-free. Kill switch = off + restart. Any other value -> off.
# CORA_DELEGATED_USER_DAILY=3                        # optional; default 3 (delegated jobs per requester per AZ day; founder exempt)
# CORA_DELEGATED_ORG_DAILY=10                        # optional; default 10 (delegated jobs org-wide per AZ day)
# CORA_DELEGATED_JOB_USD=2.00                        # optional; default 2.00 (per-job est-USD cap; worker aborts with graceful partial delivery)
# CORA_DELEGATED_MONTHLY_USD=50.00                   # optional; default 50.00 (monthly envelope: MTD spend + open-job reservation, AZ month)
# CORA_DELEGATED_MODEL=                              # optional; default = model_router.MODEL_SONNET (the delegated worker's model; no Opus/Haiku legs in v1)
# CORA_SESSIONS_CHANNEL=#cora-sessions               # optional; default #cora-sessions (the delegated-work runner's machine-lane START/DONE/FAIL lines)
# CORA_GAP_DETECT_DAILY_CAP=                         # optional; default = _DEFAULT_DAILY_CAP (gap-detection DM cap)
# CORA_KB_MISS_SHADOW_FLOOR=                          # optional; default 1.06 (LOG-ONLY high-distance-answered watch, D-088 negative result; never gates)
# CORA_OPERATIONAL_TTL_DAYS=                          # optional; default 7 (operational proposal TTL-at-creation; knowledge items never expire)
# CORA_DECISIONS_INBOX_PATH=                          # optional; default = data/decisions-inbox.md (Fork 4 NON-canon decisions inbox; accepted decision cards land here, promotion to decisions.md stays the Cowork cascade)
# CORA_DECISIONS_INBOX_LEDGER=                        # optional; default = data/state/decisions-inbox-ledger.jsonl (accepted-decision ledger: idempotency + digest counts)
# Company lexicon (Lexicon Flywheel v1, 2026-08-01). off (default, fully inert) |
# resolve (loader + resolver + chokepoint telemetry for programmatic consumers;
# zero behavior change) | full (adds prompt injection + mining proposals + the
# cora_lexicon_add teach tool). BOT-LOADED read: the bot snapshots .env at
# startup, so flipping this for the bot needs the edit + a restart; scheduled
# scripts re-read .env each fire. Any other value falls back to off.
# CORA_LEXICON=resolve                                # off (default) | resolve | full
# LEXICON_DIR=                                        # optional; default = data/maps/lexicon (test override)
# LEXICON_SKU_ALIASES_PATH=                           # optional; default = data/maps/f3e-sku-aliases.yaml (test override)
# LEXICON_USER_ALIASES_PATH=                          # optional; default = data/maps/user-aliases.yaml (test override)
# LEXICON_RESOLUTIONS_PATH=                           # optional; default = logs/lexicon-resolutions.jsonl (test override)
# LEXICON_ROSTER_PATH=                                # optional; default = data/maps/slack-to-asana.yaml (person-canonical roster validation; test override)
# LEXICON_FINGERPRINTS_PATH=                          # optional; default = data/state/lexicon-fingerprints.jsonl (mining dedup ledger; test override)
# LEXICON_CANDIDATES_PATH=                            # optional; default = data/state/lexicon-candidates.jsonl (lane-B no-canonical ledger; test override)
# Slack interactive Confirm/Cancel + candidate-picker buttons on every F-23
# staged-write preview (v1, design 2026-08-02). off (default) = text-only
# previews, byte-identical to before this feature (typed "@Cora confirm" is
# UNAFFECTED either way -- this flag only controls whether Block Kit buttons
# also render). Kill switch = off + a bot restart (BOT-LOADED: app.py +
# tool_dispatch.py snapshot .env at start).
# CORA_CONFIRM_BUTTONS=on                             # off (default) | on
# CORA_FOUNDER_SLACK_ID=U0B2RM2JYJ1                   # optional; default Harrison. The founder the read-only MCP server (scripts/run_mcp_server.py) serves; resolves the founder mailboxes for its Tier-1 teammate-email-header strip.
# CORA_MCP_HTTP_TOKEN=                                # optional; if set, scripts/run_mcp_server_http.py requires `Authorization: Bearer <token>` on every request (constant-time compare, 401 otherwise). Unset = loopback bind is the only gate (v1-accepted, 2026-07-30 locked fork #2). Bind host is HARD-CODED 127.0.0.1 -- no env var can change it.
# CORA_MCP_HTTP_PORT=8791                             # optional; default 8791. Port for the local MCP streamable-HTTP bridge (Cowork lane). Do NOT set to 8787 -- that's Cora's bot health endpoint.
# CORA_MCP_HTTP_CERT=data\state\mcp-tls\cert.pem       # optional; set together with CORA_MCP_HTTP_KEY (both-or-neither) to serve https:// instead of http:// -- needed because Cowork's Add-connector UI rejects a plain http:// URL on scheme alone (2026-07-30 GO/NO-GO finding). Generate the pair with deployment\new-mcp-https-cert.ps1 (self-signed, loopback-SAN-only leaf cert). Gitignored (data/state/mcp-tls/) -- never commit these files.
# CORA_MCP_HTTP_KEY=data\state\mcp-tls\key.pem         # optional; see CORA_MCP_HTTP_CERT above.
# KB_DECISION_LOG_PATH=                              # optional; default = logs/kb-retrieval-decisions.jsonl (per-query retrieval-decision + shadow stream)

# -----------------------------------------------------------------------------
# Gap-autofill / friction-mining / strategy-memo -- state + source paths
# -----------------------------------------------------------------------------
# All optional; default to repo-relative data/ + logs/ paths. Override only to
# relocate state files. GAP_AUTOFILL_SOURCES picks which swept sources to mine.
# GAP_AUTOFILL_SOURCES=slack                         # default "slack"
# GAP_AUTOFILL_STATE_PATH=                           # optional; default = data/state/gap-autofill-state.json
# GAP_ASK_PENDING_PATH=                              # optional; default = data/state/gap-ask-pending.jsonl
# GAP_DOMAIN_OWNERS_PATH=                            # optional; default = data/maps/gap-domain-owners.yaml
# GAP_DETECTION_STATE_PATH=                          # optional; default = data/state/gap-detection-state.json
# RESOLVED_GAPS_PATH=                                # optional; default = design/known-answers/.resolved-gaps.jsonl
# KNOWLEDGE_GAPS_LOG_PATH=                           # optional; default = logs/knowledge-gaps.jsonl
# GOLDEN_SET_AUTO_PATH=                              # optional; default = data/evals/golden-set-auto.yaml
# EFFICIENCY_BACKLOG_PATH=                           # optional; default = design/efficiency-backlog.md
# CLOSURE_NUDGE_LOG_PATH=                            # optional; default = data/state/closure-nudges-throttle.jsonl
# FRICTION_KB_DB_PATH=                               # optional; default = data/cora_kb.db
# Missed-Message Catch-Up (scripts/run_missed_message_catchup.py):
# MISSED_CATCHUP_LEDGER_PATH=                        # optional; default = data/state/missed-message-catchup.jsonl
# CATCHUP_REPLY_PREFACE=                             # optional; delay preface prepended to non-trivial approved catch-up replies
# FRICTION_LEDGER_PATH=                              # optional; default = data/state/friction-findings-ledger.jsonl
# STRATEGY_MEMO_DIR=                                 # optional; default = Drive 00-Founder/_strategy-memos
# STRATEGY_SNAPSHOT_DIR=                             # optional; default = data/state/strategy-memo-snapshots
# STRATEGY_DECISIONS_PATH=                           # optional; default = memory/decisions-pending.md
# STRATEGY_KB_DB_PATH=                               # optional; default = data/cora_kb.db
# STRATEGY_ASANA_MAP_PATH=                           # optional; default = data/maps/asana-project-map.yaml
# STRATEGY_HEARTBEAT_PATH=                           # optional; default = data/health/heartbeat.txt
# SYNTHESIS_SNAPSHOT_DIR=                            # optional; default = data/state/synthesis-snapshots (daily channel synthesis, per-scope)

# -----------------------------------------------------------------------------
# AI-Visibility Engine (F3 "in-house BeFound"; F3E only; PHI guard OFF)
# -----------------------------------------------------------------------------
# Grounded AI-search surfaces. The scan fail-soft-skips any surface whose key is
# missing. OPENAI_API_KEY / ANTHROPIC_API_KEY are shared with the rest of Cora.
PERPLEXITY_API_KEY=your-perplexity-key-here          # optional; default "" (Perplexity surface off)
GEMINI_API_KEY=your-gemini-api-key-here              # optional; default "" (Gemini-grounded surface off). Distinct from the Google service account.
OTTERLY_API_KEY=your-otterly-api-key-here            # optional; default "" (Google AI Overviews slice off). Single-workspace scoped.
# AI_VISIBILITY_CHANNEL=f3-ai-visibility             # optional; default C0BFXEJ1UJU (#f3-ai-visibility). --channel overrides.
# --- tuning (all optional; sensible defaults) ---
# AI_VIS_PERPLEXITY_MODEL=sonar                      # optional; default sonar
# AI_VIS_OPENAI_MODEL=gpt-4.1                        # optional; default gpt-4.1 (Responses API web_search)
# AI_VIS_GEMINI_MODEL=gemini-2.5-flash               # optional; default gemini-2.5-flash
# AI_VIS_CLAUDE_MODEL=claude-sonnet-4-6              # optional; default claude-sonnet-4-6
# AI_VIS_HTTP_TIMEOUT=45                             # optional; per-call HTTP timeout seconds; default 45
# AI_VIS_CONCURRENCY=4                               # optional; per-provider concurrency cap; default 4
# AI_VIS_CITATION_TIMEOUT=6                          # optional; citation HEAD/GET timeout seconds; default 6
# AI_VIS_CITATION_WORKERS=8                          # optional; citation verify thread pool size; default 8
# OTTERLY_BASE_URL=https://data.otterly.ai/v1        # optional; default https://data.otterly.ai/v1
# OTTERLY_HTTP_TIMEOUT=30                            # optional; default 30
# OTTERLY_AIO_ENGINE=google                         # optional; Otterly engine id for Google AI Overviews (validated against /engines)

# -----------------------------------------------------------------------------
# Drive (G:) mount resilience -- drive_io wrapper (2026-07-16)
# -----------------------------------------------------------------------------
# All defaults are production-correct; override only for tuning/tests. The wrapper
# makes every local G: read/write timeout-bounded + retried so a transient Google-
# Drive unmount/remount can never freeze the bot (it degrades to cached context).
# DRIVE_IO_MOUNT_ANCHOR=G:\My Drive\HJR-Founder-OS   # optional; reachability-probe anchor; default this path
# DRIVE_IO_TIMEOUT_SECONDS=10                        # optional; per-attempt worker join deadline; default 10
# DRIVE_IO_RETRY_SECONDS=90                          # optional; default (scheduled-job) retry window; default 90
# DRIVE_IO_BACKOFF_SECONDS=1                         # optional; sleep between retry attempts; default 1
# DRIVE_IO_BREAKER_SECONDS=30                        # optional; circuit-breaker fast-fail window after a confirmed outage; default 30
# DRIVE_IO_MONITOR_INTERVAL_SECS=300                 # optional; G: reachability breadcrumb probe interval (Slice 4, observability only); default 300

# -----------------------------------------------------------------------------
# Revenue-ops loop -- send-trust ladder (2026-08-02, design locked 2026-08-01)
# -----------------------------------------------------------------------------
# Global email-send kill switch. off (the default, incl. unset or ANY
# unrecognized value) = Tier 0 everywhere: nothing sends, even on an approved
# card; the silence-nudge sweep degrades to Tier-0 Gmail drafts. tier1 enables
# approve-then-send for tier-1 playbooks in data/maps/send-trust.yaml
# (v1: silence_nudge only, mailbox harrison@hjrglobal.com, approver Harrison).
# BOT-SIDE the value is read at process start -- flipping it requires a
# restart; the sweep script reads it per-fire. Ships dark: flip only after
# the controlled Tier-1 smoke.
# CORA_SEND_LIVE=off                                 # off (default) | tier1
# CORA_REVOPS_DB=                                    # optional; default data\revops_ledger.db (cadence ledger SQLite; tests point it at a tmp file)

# -----------------------------------------------------------------------------
# Session snapshots -- SLIM session-comms file lane (2026-07-31)
# -----------------------------------------------------------------------------
# Durable JSON snapshots of the D-092 read surface (src/cora/session_snapshots.py),
# written by a fail-soft bot daemon + mirrored to the Drive _brain bus. Defaults
# are production-correct; the overrides exist for tests/relocation only.
# CORA_SNAPSHOT_DIR=                                 # optional; default data\session-bus\snapshots (repo lane, gitignored). MUST stay on a LOCAL volume -- repo-lane writes are unbounded raw I/O; the G: mirror is the Drive-visible lane (never point this at G:)
# CORA_SNAPSHOT_MIRROR_DIR=                          # optional; default G:\My Drive\HJR-Founder-OS\_brain\_bus\snapshots
# CORA_SNAPSHOT_INTERVAL_SECS=60                     # optional; writer tick interval; min 10; default 60

